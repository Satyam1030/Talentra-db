// ====================================================================
// TALENTRA - Complete Database Model (100% Docket Coverage)
// Paste this into https://dbdiagram.io to see the full ER Diagram
// Covers: Master Data, Identity, RBAC, Licensing, Candidate Profiles,
// Jobs, Applications, Gig Marketplace, Subscriptions, Wallets,
// Notifications, Screening, Analytics Star Schema (Phase 4)
// ====================================================================


// ====================================================================
// SECTION 1: MASTER DATA & LOOKUP TABLES
// Rule Group 1 (naming), Rule Group 3 (enums as lookup tables)
// ====================================================================

Table country {
  id bigint [pk, increment]
  iso2_code char(2) [unique, not null, note: 'ISO 3166-1 alpha-2']
  iso3_code char(3) [unique, not null, note: 'ISO 3166-1 alpha-3']
  country_name varchar(100) [not null]
  phone_country_code varchar(10) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table state_province {
  id bigint [pk, increment]
  country_id bigint [not null]
  state_name varchar(100) [not null]
  state_code varchar(10) [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table city {
  id bigint [pk, increment]
  state_province_id bigint [not null]
  city_name varchar(100) [not null]
  latitude decimal(9,6) [null]
  longitude decimal(9,6) [null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table skill {
  id bigint [pk, increment]
  skill_code varchar(50) [unique, not null]
  skill_name varchar(100) [not null]
  skill_category varchar(50) [not null, note: 'TECHNICAL, SOFT, DOMAIN, LANGUAGE']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
}

Table language_lookup {
  id bigint [pk, increment]
  iso_code varchar(5) [unique, not null, note: 'BCP 47 e.g. en-US, hi-IN']
  language_name varchar(100) [not null]
  is_active boolean [not null, default: true]
}

Table industry_lookup {
  id bigint [pk, increment]
  industry_code varchar(50) [unique, not null]
  display_name varchar(100) [not null]
  is_active boolean [not null, default: true]
}

Table job_type_lookup {
  id bigint [pk, increment]
  type_code varchar(30) [unique, not null, note: 'FULL_TIME, PART_TIME, CONTRACT_IT, GENERAL_STAFFING, APPRENTICE, CAMPUS, GIG']
  display_name varchar(50) [not null]
  is_active boolean [not null, default: true]
}

Table application_status_lookup {
  id bigint [pk, increment]
  status_code varchar(30) [unique, not null, note: 'APPLIED, SHORTLISTED, INTERVIEWED, OFFERED, JOINED, REJECTED, WITHDRAWN']
  display_name varchar(50) [not null]
  sort_order int [not null]
  is_terminal boolean [not null, default: false, note: 'JOINED, REJECTED, WITHDRAWN are terminal states']
  is_active boolean [not null, default: true]
}

Table ui_translation {
  id bigint [pk, increment]
  translation_key varchar(150) [not null]
  language_lookup_id bigint [not null]
  translated_text text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}


// ====================================================================
// SECTION 2: IDENTITY, ROLES & ACCESS CONTROL
// Rule Groups 1, 2, 4, 9
// ====================================================================

Table app_user {
  id bigint [pk, increment]
  email varchar(254) [unique, not null]
  password_hash varchar(255) [not null, note: 'Argon2id hash. Never plaintext.']
  user_type varchar(30) [not null, note: 'CANDIDATE, RECRUITER, CONSULTANT, ADMIN, TPO']
  phone_number varchar(20) [not null]
  phone_country_code varchar(10) [not null]
  preferred_language_id bigint [null]
  country_id bigint [not null]
  is_verified boolean [not null, default: false]
  identity_verification_status varchar(30) [not null, default: 'UNVERIFIED', note: 'UNVERIFIED, PENDING, PASSED, FAILED']
  identity_verification_token varchar(255) [null, note: 'Token from identity provider. NOT raw national ID.']
  is_active boolean [not null, default: true]
  deleted_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [null, note: 'NULL for self-registration']
  updated_at timestamp [not null, default: `now()`]
  updated_by bigint [null]
}

Table role_lookup {
  id bigint [pk, increment]
  role_code varchar(50) [unique, not null, note: 'SUPER_ADMIN, ACCOUNT_ADMIN, RECRUITER, CONSULTANT, TPO, CANDIDATE']
  description varchar(255) [not null]
}

Table permission_lookup {
  id bigint [pk, increment]
  permission_code varchar(100) [unique, not null, note: 'CANDIDATE_PROFILE_DOWNLOAD, JOB_POSTING_CREATE, REPORT_VIEW']
  description varchar(255) [not null]
  resource_type varchar(50) [not null]
}

Table role_permission_mapping {
  id bigint [pk, increment]
  role_lookup_id bigint [not null]
  permission_lookup_id bigint [not null]
}

Table user_role_mapping {
  id bigint [pk, increment]
  app_user_id bigint [not null]
  role_lookup_id bigint [not null]
  assigned_at timestamp [not null, default: `now()`]
  assigned_by bigint [not null]
}

Table user_consent_record {
  id bigint [pk, increment]
  app_user_id bigint [not null]
  consent_type varchar(50) [not null, note: 'TERMS_OF_SERVICE, PRIVACY_POLICY, MARKETING, DATA_PROCESSING']
  consent_version varchar(20) [not null]
  is_granted boolean [not null]
  ip_address varchar(45) [not null]
  user_agent varchar(255) [not null]
  consented_at timestamp [not null, default: `now()`]
}

Table user_session {
  id bigint [pk, increment]
  app_user_id bigint [not null]
  device_identifier varchar(128) [not null, note: 'Hashed device fingerprint']
  device_type varchar(30) [null, note: 'WEB, ANDROID, IOS, DESKTOP']
  ip_address varchar(45) [not null]
  user_agent varchar(500) [not null]
  session_token_hash varchar(255) [not null, note: 'SHA-256 hash of JWT. Never store raw token.']
  session_start timestamp [not null, default: `now()`]
  last_activity timestamp [not null, default: `now()`]
  session_end timestamp [null]
  is_revoked boolean [not null, default: false]
}

Table audit_trail {
  id bigint [pk, increment, note: 'Append-only. No UPDATE or DELETE ever.']
  actor_user_id bigint [null, note: 'NULL for system-initiated actions']
  action_type varchar(50) [not null, note: 'LOGIN, LOGOUT, PROFILE_VIEW, DOWNLOAD, STATUS_CHANGE, SEAT_EXCEEDED']
  entity_name varchar(50) [not null, note: 'Table name e.g. candidate_profile']
  entity_id bigint [not null]
  ip_address varchar(45) [not null]
  old_value_payload text [null, note: 'JSON snapshot of previous state']
  new_value_payload text [null, note: 'JSON snapshot of new state']
  created_at timestamp [not null, default: `now()`]
}


// ====================================================================
// SECTION 3: LICENSING, SEATS & DEVICE CONTROL
// Rule Groups 9, 10 (non-overlapping constraints enforced at DB level)
// ====================================================================

Table license {
  id bigint [pk, increment]
  organization_id bigint [not null]
  license_key varchar(100) [unique, not null]
  plan_name varchar(100) [not null]
  max_users int [not null, note: 'Check constraint: max_users > 0']
  max_devices_per_user int [not null, note: 'Check constraint: max_devices_per_user > 0']
  valid_from timestamp [not null]
  valid_to timestamp [not null, note: 'Check constraint: valid_to > valid_from']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
  updated_at timestamp [not null, default: `now()`]
  updated_by bigint [not null]
}

Table license_seat_allocation {
  id bigint [pk, increment]
  license_id bigint [not null]
  app_user_id bigint [not null]
  allocated_at timestamp [not null, default: `now()`]
  allocated_by bigint [not null]
  revoked_at timestamp [null]
  revoked_by bigint [null]
}


// ====================================================================
// SECTION 4: ORGANISATIONS & CLIENT ACCOUNTS
// Rule Groups 1, 2, 4
// ====================================================================

Table organization {
  id bigint [pk, increment]
  legal_name varchar(150) [not null]
  trade_name varchar(150) [null, note: 'Nullable: not all orgs have a trade name']
  tax_identifier varchar(50) [unique, not null, note: 'Classified: SENSITIVE. Stored hashed or encrypted.']
  industry_lookup_id bigint [not null]
  country_id bigint [not null]
  city_id bigint [not null]
  website_url varchar(255) [null]
  employee_count_range varchar(20) [null, note: '1-10, 11-50, 51-200, 201-500, 500+']
  logo_object_reference varchar(500) [null, note: 'Pointer to object storage. Not binary data.']
  verification_status varchar(30) [not null, default: 'PENDING', note: 'PENDING, VERIFIED, REJECTED, SUSPENDED']
  verified_at timestamp [null]
  verified_by bigint [null]
  is_active boolean [not null, default: true]
  deleted_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
  updated_at timestamp [not null, default: `now()`]
  updated_by bigint [not null]
}

Table recruiter_organization_mapping {
  id bigint [pk, increment]
  organization_id bigint [not null]
  app_user_id bigint [not null]
  is_account_admin boolean [not null, default: false]
  effective_from timestamp [not null, default: `now()`]
  effective_to timestamp [null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
}


// ====================================================================
// SECTION 5: SUBSCRIPTION PLANS & MONETIZATION
// Rule Groups 10 (non-overlapping plan periods enforced via exclusion constraint)
// ====================================================================

Table subscription_plan {
  id bigint [pk, increment]
  plan_code varchar(50) [unique, not null, note: 'STARTER, PROFESSIONAL, ENTERPRISE, CAMPUS_TPO']
  display_name varchar(100) [not null]
  monthly_price decimal(12,2) [not null]
  annual_price decimal(12,2) [not null]
  price_currency varchar(3) [not null, default: 'USD']
  included_credits int [not null, default: 0, note: 'Credits for profile downloads per billing cycle']
  max_active_jobs int [not null, default: 5]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table organization_subscription {
  id bigint [pk, increment]
  organization_id bigint [not null]
  subscription_plan_id bigint [not null]
  billing_cycle varchar(10) [not null, note: 'MONTHLY, ANNUAL']
  amount_paid decimal(12,2) [not null]
  currency varchar(3) [not null, default: 'USD']
  valid_from timestamp [not null]
  valid_to timestamp [not null, note: 'Check constraint: valid_to > valid_from. Exclusion constraint prevents overlap per org.']
  auto_renew boolean [not null, default: true]
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE, EXPIRED, CANCELLED']
  cancelled_at timestamp [null]
  cancelled_by bigint [null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
}

Table payment_order {
  id bigint [pk, increment]
  organization_id bigint [not null]
  organization_subscription_id bigint [null, note: 'NULL if this is a standalone credit top-up']
  amount decimal(12,2) [not null]
  currency varchar(3) [not null, default: 'USD']
  gateway_reference_id varchar(255) [not null, note: 'Webhook reference ID from Stripe/Razorpay. NOT card number.']
  gateway_name varchar(50) [not null, note: 'STRIPE, RAZORPAY, PAYPAL']
  status varchar(30) [not null, note: 'INITIATED, SUCCESS, FAILED, REFUNDED']
  failure_reason varchar(255) [null]
  initiated_at timestamp [not null, default: `now()`]
  settled_at timestamp [null]
}

Table wallet_account {
  id bigint [pk, increment]
  organization_id bigint [unique, not null]
  current_balance_credits int [not null, default: 0, note: 'Check constraint: >= 0']
  currency varchar(3) [not null, default: 'USD']
  is_locked boolean [not null, default: false, note: 'Locked during high-concurrency credit deductions']
  updated_at timestamp [not null, default: `now()`]
}

Table wallet_ledger_entry {
  id bigint [pk, increment, note: 'Append-only ledger. No UPDATE or DELETE ever. Use reversal_of_entry_id for corrections.']
  wallet_account_id bigint [not null]
  transaction_type varchar(40) [not null, note: 'RECHARGE, PLAN_CREDIT, PROFILE_DOWNLOAD, OUTREACH_DEBIT, REFUND, ADJUSTMENT']
  credit_change int [not null, note: 'Positive for credits in, negative for debits out']
  balance_after int [not null, note: 'Snapshot of balance after this entry. Prevents need to SUM the entire ledger.']
  payment_order_id bigint [null, note: 'Linked payment if this is a recharge entry']
  reference_entity_id bigint [null, note: 'e.g. candidate_profile_id for a PROFILE_DOWNLOAD debit']
  reversal_of_entry_id bigint [null, note: 'Self-reference: set when this entry corrects a prior entry']
  description varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
}

Table profile_download_history {
  id bigint [pk, increment]
  actor_user_id bigint [not null]
  organization_id bigint [not null]
  candidate_profile_id bigint [not null]
  wallet_ledger_entry_id bigint [not null, note: 'Links to the debit entry for auditability']
  credit_deducted int [not null, default: 1]
  downloaded_at timestamp [not null, default: `now()`]
}


// ====================================================================
// SECTION 6: CANDIDATE PROFILE - COMPLETE
// Rule Groups 2, 3, 4, 5, 6
// ====================================================================

Table candidate_profile {
  id bigint [pk, increment]
  app_user_id bigint [unique, not null]
  first_name varchar(75) [not null]
  last_name varchar(75) [not null]
  headline varchar(150) [null, note: 'Nullable: new candidates may not set a headline']
  city_id bigint [not null]
  total_experience_months int [not null, default: 0, note: 'Check constraint: >= 0. Computed and cached.']
  current_salary decimal(12,2) [null, note: 'Nullable: fresher candidates have no current salary. Classified: SENSITIVE.']
  expected_salary decimal(12,2) [null]
  salary_currency varchar(3) [null, default: 'USD']
  notice_period_days int [not null, default: 30]
  profile_summary text [null, note: 'Unbounded text permitted per Rule Group 3']
  profile_completion_percentage int [not null, default: 0, note: 'Check: 0-100']
  is_open_to_work boolean [not null, default: true]
  is_gig_worker boolean [not null, default: false]
  is_blocked_from_search boolean [not null, default: false]
  deleted_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
  updated_at timestamp [not null, default: `now()`]
  updated_by bigint [not null]
}

Table candidate_resume {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  version_label varchar(50) [not null, note: 'e.g. General, Backend Dev, Remote Only']
  object_storage_reference varchar(500) [not null, note: 'Pointer to secure object storage. Not binary data.']
  file_name varchar(255) [not null]
  file_size_bytes int [not null]
  is_primary boolean [not null, default: false]
  uploaded_at timestamp [not null, default: `now()`]
}

Table candidate_skill {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  skill_id bigint [not null]
  experience_months int [not null, default: 0]
  proficiency_level varchar(20) [not null, note: 'BEGINNER, INTERMEDIATE, ADVANCED, EXPERT']
  is_primary boolean [not null, default: false]
}

Table candidate_experience {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  company_name varchar(150) [not null]
  designation varchar(100) [not null]
  city_id bigint [null]
  employment_type varchar(30) [not null, note: 'FULL_TIME, PART_TIME, FREELANCE, INTERNSHIP']
  start_date date [not null]
  end_date date [null, note: 'Nullable: NULL means current. Check: end_date >= start_date.']
  is_current boolean [not null, default: false]
  description text [null]
}

Table candidate_education {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  institution_name varchar(150) [not null]
  degree_name varchar(100) [not null]
  field_of_study varchar(100) [not null]
  graduation_year int [not null, note: 'Check: >= 1950 AND <= current_year + 6']
  grade_or_gpa varchar(20) [null, note: 'Nullable: not all institutions provide grades']
  is_verified boolean [not null, default: false]
}

Table candidate_project {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  project_title varchar(150) [not null]
  description text [not null]
  tech_stack varchar(255) [null, note: 'Comma-separated or JSON array of technologies used']
  project_url varchar(500) [null]
  start_date date [null]
  end_date date [null, note: 'Check: end_date >= start_date']
  is_ongoing boolean [not null, default: false]
}

Table candidate_language {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  language_lookup_id bigint [not null]
  proficiency_level varchar(20) [not null, note: 'BASIC, CONVERSATIONAL, PROFESSIONAL, NATIVE']
}

Table candidate_assessment {
  id bigint [pk, increment]
  candidate_profile_id bigint [not null]
  assessment_name varchar(100) [not null]
  skill_id bigint [null]
  score decimal(5,2) [not null]
  max_score decimal(5,2) [not null, note: 'Check: score <= max_score']
  percentile decimal(5,2) [null, note: 'Check: 0-100']
  assessed_at timestamp [not null]
  is_verified boolean [not null, default: false]
  external_certificate_url varchar(500) [null]
}

Table candidate_blocking_entry {
  id bigint [pk, increment, note: 'Blocks organization or user from viewing this candidate. Enforced at query level.']
  candidate_profile_id bigint [not null]
  blocked_organization_id bigint [null, note: 'Nullable: block is org-level OR user-level, not both required']
  blocked_user_id bigint [null]
  reason varchar(255) [null]
  created_at timestamp [not null, default: `now()`]
}

Table profile_view_history {
  id bigint [pk, increment]
  viewed_candidate_id bigint [not null]
  viewer_user_id bigint [not null]
  viewer_organization_id bigint [null]
  viewed_at timestamp [not null, default: `now()`]
}

Table recruiter_bookmark {
  id bigint [pk, increment]
  recruiter_user_id bigint [not null]
  candidate_profile_id bigint [not null]
  note text [null]
  created_at timestamp [not null, default: `now()`]
}

Table candidate_job_preference {
  id bigint [pk, increment]
  candidate_profile_id bigint [unique, not null]
  preferred_job_type_id bigint [null]
  preferred_city_id bigint [null]
  is_open_to_remote boolean [not null, default: false]
  is_open_to_relocate boolean [not null, default: false]
  min_expected_salary decimal(12,2) [null]
  max_expected_salary decimal(12,2) [null]
  salary_currency varchar(3) [null, default: 'USD']
  updated_at timestamp [not null, default: `now()`]
}


// ====================================================================
// SECTION 7: JOB REQUIREMENTS & APPLICATION PIPELINE
// Core Phase 1 Domain
// ====================================================================

Table job_requirement {
  id bigint [pk, increment]
  organization_id bigint [not null]
  created_by_user_id bigint [not null]
  title varchar(150) [not null]
  job_type_lookup_id bigint [not null]
  city_id bigint [not null]
  is_remote boolean [not null, default: false]
  vacancies int [not null, default: 1, note: 'Check: > 0']
  min_experience_months int [not null, default: 0, note: 'Check: >= 0']
  max_experience_months int [not null, note: 'Check: >= min_experience_months']
  min_salary decimal(12,2) [null]
  max_salary decimal(12,2) [null, note: 'Check: max_salary >= min_salary when both are not null']
  salary_currency varchar(3) [default: 'USD']
  is_salary_disclosed boolean [not null, default: false]
  is_consultant_open boolean [not null, default: false]
  publish_state varchar(20) [not null, default: 'DRAFT', note: 'DRAFT, PUBLISHED, PAUSED, CLOSED, EXPIRED']
  published_at timestamp [null]
  closes_at timestamp [null]
  job_description text [not null]
  deleted_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
  updated_at timestamp [not null, default: `now()`]
  updated_by bigint [not null]
}

Table job_requirement_skill {
  id bigint [pk, increment]
  job_requirement_id bigint [not null]
  skill_id bigint [not null]
  is_mandatory boolean [not null, default: true]
  min_experience_months int [not null, default: 0]
}

Table job_questionnaire {
  id bigint [pk, increment]
  job_requirement_id bigint [unique, not null]
  title varchar(150) [not null]
  is_mandatory boolean [not null, default: false, note: 'Candidate must complete before submitting application']
  created_at timestamp [not null, default: `now()`]
}

Table questionnaire_question {
  id bigint [pk, increment]
  job_questionnaire_id bigint [not null]
  question_text text [not null]
  question_type varchar(30) [not null, note: 'TEXT, SINGLE_CHOICE, MULTI_CHOICE, YES_NO, RATING']
  is_mandatory boolean [not null, default: true]
  sort_order int [not null, default: 1]
  options_payload text [null, note: 'JSON array of choices for SINGLE_CHOICE / MULTI_CHOICE']
}

Table job_application {
  id bigint [pk, increment]
  job_requirement_id bigint [not null]
  candidate_profile_id bigint [not null]
  candidate_resume_id bigint [null, note: 'Nullable: candidate may apply without attaching a specific resume']
  current_status_id bigint [not null]
  source_type varchar(30) [not null, default: 'ORGANIC', note: 'ORGANIC, RECRUITER_SOURCED, CONSULTANT_REFERRAL, CAMPUS']
  sourced_by_user_id bigint [null, note: 'Nullable: populated when source_type != ORGANIC']
  submitted_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table application_status_history {
  id bigint [pk, increment, note: 'Append-only. Full audit trail of every status transition.']
  job_application_id bigint [not null]
  status_lookup_id bigint [not null]
  actor_user_id bigint [not null]
  comment text [null]
  transitioned_at timestamp [not null, default: `now()`]
}

Table questionnaire_response {
  id bigint [pk, increment]
  job_application_id bigint [not null]
  questionnaire_question_id bigint [not null]
  response_text text [null, note: 'Used for TEXT type responses']
  response_option_index int [null, note: 'Used for SINGLE_CHOICE / YES_NO responses']
  response_option_indices varchar(255) [null, note: 'JSON array for MULTI_CHOICE responses']
  submitted_at timestamp [not null, default: `now()`]
}

Table consultant_sourcing_request {
  id bigint [pk, increment]
  job_requirement_id bigint [not null]
  consultant_user_id bigint [not null]
  requesting_organization_id bigint [not null]
  status varchar(30) [not null, default: 'PENDING', note: 'PENDING, APPROVED, REJECTED, REVOKED']
  approval_note text [null]
  approved_by bigint [null]
  approved_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
}


// ====================================================================
// SECTION 8: GIG MARKETPLACE (Dedicated Subsystem)
// Architectural choice: Separate subsystem for strict gig business rules
// ====================================================================

Table gig_worker_profile {
  id bigint [pk, increment]
  candidate_profile_id bigint [unique, not null]
  headline varchar(150) [not null]
  hourly_rate decimal(10,2) [not null, note: 'Check: > 0']
  rate_currency varchar(3) [not null, default: 'USD']
  availability_status varchar(30) [not null, default: 'AVAILABLE', note: 'AVAILABLE, BUSY, INACTIVE']
  average_rating decimal(3,2) [not null, default: 0.00, note: 'Check: 0.00 to 5.00. Cached/materialized.']
  total_ratings_count int [not null, default: 0]
  completed_gigs_count int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table gig_worker_availability {
  id bigint [pk, increment, note: 'Non-overlapping windows enforced via EXCLUDE USING gist (gig_worker_profile_id WITH =, daterange(available_from, available_to) WITH &&)']
  gig_worker_profile_id bigint [not null]
  available_from date [not null]
  available_to date [not null, note: 'Check: available_to > available_from']
  availability_type varchar(20) [not null, note: 'AVAILABLE, BLOCKED']
  note varchar(255) [null]
  created_at timestamp [not null, default: `now()`]
}

Table gig_request {
  id bigint [pk, increment]
  organization_id bigint [not null]
  created_by_user_id bigint [not null]
  title varchar(150) [not null]
  pricing_type varchar(20) [not null, note: 'FIXED_PRICE, HOURLY_RATE']
  budget_amount decimal(12,2) [not null, note: 'Check: > 0']
  budget_currency varchar(3) [not null, default: 'USD']
  required_skill_id bigint [null]
  start_window date [not null]
  end_window date [not null, note: 'Check: end_window >= start_window']
  estimated_hours int [null, note: 'Nullable for FIXED_PRICE gigs']
  status varchar(30) [not null, default: 'OPEN', note: 'OPEN, ASSIGNED, COMPLETED, CANCELLED']
  description text [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table gig_application {
  id bigint [pk, increment]
  gig_request_id bigint [not null]
  gig_worker_profile_id bigint [not null]
  proposed_rate decimal(10,2) [not null, note: 'Check: > 0']
  cover_note text [null]
  application_status varchar(30) [not null, default: 'PENDING', note: 'PENDING, ACCEPTED, REJECTED, WITHDRAWN']
  applied_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table gig_assignment {
  id bigint [pk, increment]
  gig_request_id bigint [unique, not null]
  gig_worker_profile_id bigint [not null]
  agreed_rate decimal(10,2) [not null]
  external_handoff_reference varchar(100) [not null, note: 'Reference ID from external gig fulfillment system']
  fulfillment_status varchar(30) [not null, default: 'IN_PROGRESS', note: 'IN_PROGRESS, DELIVERED, DISPUTED, RECONCILED']
  reconciled_earnings decimal(12,2) [null, note: 'Nullable until external system reconciles']
  rating_by_requester decimal(2,1) [null, note: 'Check: 1.0 to 5.0. Nullable until gig is completed.']
  review_by_requester text [null]
  rating_by_worker decimal(2,1) [null, note: 'Check: 1.0 to 5.0']
  review_by_worker text [null]
  assigned_at timestamp [not null, default: `now()`]
  completed_at timestamp [null]
}

Table gig_favorite_blacklist {
  id bigint [pk, increment]
  organization_id bigint [not null]
  gig_worker_profile_id bigint [not null]
  entry_type varchar(15) [not null, note: 'FAVORITE or BLACKLISTED']
  reason varchar(255) [null]
  created_at timestamp [not null, default: `now()`]
  created_by bigint [not null]
}


// ====================================================================
// SECTION 9: NOTIFICATIONS & USER PREFERENCES
// Rule Group 4 (audit), high-throughput - partitioned by created_at month
// ====================================================================

Table user_preference {
  id bigint [pk, increment]
  app_user_id bigint [unique, not null]
  email_notifications_enabled boolean [not null, default: true]
  sms_notifications_enabled boolean [not null, default: false]
  push_notifications_enabled boolean [not null, default: true]
  job_alert_frequency varchar(20) [not null, default: 'DAILY', note: 'INSTANT, DAILY, WEEKLY, NONE']
  preferred_language_id bigint [not null]
  timezone varchar(50) [not null, default: 'UTC']
  updated_at timestamp [not null, default: `now()`]
}

Table notification_template {
  id bigint [pk, increment]
  template_code varchar(100) [unique, not null, note: 'APPLICATION_SUBMITTED, STATUS_CHANGED, GIG_ASSIGNED']
  channel varchar(20) [not null, note: 'EMAIL, SMS, PUSH']
  language_lookup_id bigint [not null]
  subject_template varchar(255) [null, note: 'For EMAIL channel only']
  body_template text [not null, note: 'Handlebars/Jinja2 template with placeholders']
  is_active boolean [not null, default: true]
  updated_at timestamp [not null, default: `now()`]
}

Table notification_delivery {
  id bigint [pk, increment, note: 'High-throughput. Partitioned by created_at (RANGE by month).']
  recipient_user_id bigint [not null]
  notification_template_id bigint [not null]
  channel varchar(20) [not null, note: 'EMAIL, SMS, PUSH']
  recipient_address varchar(255) [not null, note: 'Email or phone number at time of send. Classified: PERSONAL.']
  status varchar(20) [not null, note: 'QUEUED, SENT, DELIVERED, FAILED, BOUNCED']
  failure_reason varchar(255) [null]
  external_message_id varchar(255) [null, note: 'ID from SendGrid/Twilio for delivery tracking']
  payload_hash varchar(64) [null, note: 'SHA-256 of message body. Body dropped after retention window.']
  created_at timestamp [not null, default: `now()`]
  delivered_at timestamp [null]
}


// ====================================================================
// SECTION 10: PHASE 4 ANALYTICS STAR SCHEMA
// Prefix: dim_ for dimensions, fact_ for fact tables
// ====================================================================

Table dim_date {
  id int [pk, note: 'Surrogate key. Natural key is full_date.']
  full_date date [unique, not null]
  day_of_week int [not null]
  day_name varchar(15) [not null]
  week_of_year int [not null]
  month_number int [not null]
  month_name varchar(15) [not null]
  quarter int [not null]
  year int [not null]
  is_weekend boolean [not null]
  is_public_holiday boolean [not null, default: false]
}

Table dim_candidate {
  id bigint [pk, increment, note: 'SCD Type 2: a new row is inserted on each profile change']
  candidate_profile_id bigint [not null, note: 'Natural business key - links back to OLTP']
  first_name varchar(75) [not null]
  last_name varchar(75) [not null]
  city_name varchar(100) [not null]
  country_name varchar(100) [not null]
  total_experience_months int [not null]
  primary_skill_name varchar(100) [null]
  highest_education_degree varchar(100) [null]
  is_gig_worker boolean [not null]
  scd_effective_from timestamp [not null]
  scd_effective_to timestamp [null, note: 'NULL means current active row']
  is_current_row boolean [not null, default: true]
}

Table dim_job {
  id bigint [pk, increment, note: 'SCD Type 2 for job changes']
  job_requirement_id bigint [not null]
  title varchar(150) [not null]
  job_type_name varchar(50) [not null]
  organization_name varchar(150) [not null]
  city_name varchar(100) [not null]
  industry_name varchar(100) [not null]
  min_experience_months int [not null]
  max_experience_months int [not null]
  min_salary decimal(12,2) [null]
  max_salary decimal(12,2) [null]
  salary_currency varchar(3) [null]
  scd_effective_from timestamp [not null]
  scd_effective_to timestamp [null]
  is_current_row boolean [not null, default: true]
}

Table dim_organization {
  id bigint [pk, increment]
  organization_id bigint [not null]
  legal_name varchar(150) [not null]
  industry_name varchar(100) [not null]
  city_name varchar(100) [not null]
  country_name varchar(100) [not null]
  verification_status varchar(30) [not null]
  employee_count_range varchar(20) [null]
  scd_effective_from timestamp [not null]
  scd_effective_to timestamp [null]
  is_current_row boolean [not null, default: true]
}

Table fact_application_event {
  id bigint [pk, increment]
  dim_date_id int [not null]
  dim_candidate_id bigint [not null]
  dim_job_id bigint [not null]
  dim_organization_id bigint [not null]
  job_application_id bigint [not null, note: 'FK back to OLTP for drill-through']
  from_status_code varchar(30) [null, note: 'NULL for the initial APPLIED event']
  to_status_code varchar(30) [not null]
  source_type varchar(30) [not null]
  days_in_previous_status int [null]
  event_timestamp timestamp [not null]
}

Table fact_credit_consumption {
  id bigint [pk, increment]
  dim_date_id int [not null]
  dim_organization_id bigint [not null]
  dim_candidate_id bigint [not null]
  transaction_type varchar(40) [not null]
  credits_consumed int [not null]
  wallet_ledger_entry_id bigint [not null, note: 'FK back to OLTP for drill-through']
  event_timestamp timestamp [not null]
}

Table fact_gig_completion {
  id bigint [pk, increment]
  dim_date_id int [not null]
  dim_organization_id bigint [not null]
  gig_worker_profile_id bigint [not null]
  gig_assignment_id bigint [not null]
  pricing_type varchar(20) [not null]
  agreed_rate decimal(10,2) [not null]
  reconciled_earnings decimal(12,2) [null]
  rating_by_requester decimal(2,1) [null]
  days_to_complete int [null]
  event_timestamp timestamp [not null]
}


// ====================================================================
// SECTION 11: ALL FOREIGN KEY RELATIONSHIPS
// ====================================================================

// --- Master Data ---
Ref: state_province.country_id > country.id
Ref: city.state_province_id > state_province.id
Ref: ui_translation.language_lookup_id > language_lookup.id

// --- Identity & Access ---
Ref: app_user.country_id > country.id
Ref: app_user.preferred_language_id > language_lookup.id
Ref: user_role_mapping.app_user_id > app_user.id
Ref: user_role_mapping.role_lookup_id > role_lookup.id
Ref: role_permission_mapping.role_lookup_id > role_lookup.id
Ref: role_permission_mapping.permission_lookup_id > permission_lookup.id
Ref: user_consent_record.app_user_id > app_user.id
Ref: user_session.app_user_id > app_user.id
Ref: audit_trail.actor_user_id > app_user.id

// --- Licensing ---
Ref: license.organization_id > organization.id
Ref: license_seat_allocation.license_id > license.id
Ref: license_seat_allocation.app_user_id > app_user.id

// --- Organisation ---
Ref: organization.country_id > country.id
Ref: organization.city_id > city.id
Ref: organization.industry_lookup_id > industry_lookup.id
Ref: recruiter_organization_mapping.organization_id > organization.id
Ref: recruiter_organization_mapping.app_user_id > app_user.id

// --- Subscriptions & Payments ---
Ref: organization_subscription.organization_id > organization.id
Ref: organization_subscription.subscription_plan_id > subscription_plan.id
Ref: payment_order.organization_id > organization.id
Ref: payment_order.organization_subscription_id > organization_subscription.id
Ref: wallet_account.organization_id - organization.id
Ref: wallet_ledger_entry.wallet_account_id > wallet_account.id
Ref: wallet_ledger_entry.reversal_of_entry_id > wallet_ledger_entry.id
Ref: wallet_ledger_entry.payment_order_id > payment_order.id
Ref: profile_download_history.actor_user_id > app_user.id
Ref: profile_download_history.organization_id > organization.id
Ref: profile_download_history.candidate_profile_id > candidate_profile.id
Ref: profile_download_history.wallet_ledger_entry_id > wallet_ledger_entry.id

// --- Candidate Profile ---
Ref: candidate_profile.app_user_id - app_user.id
Ref: candidate_profile.city_id > city.id
Ref: candidate_resume.candidate_profile_id > candidate_profile.id
Ref: candidate_skill.candidate_profile_id > candidate_profile.id
Ref: candidate_skill.skill_id > skill.id
Ref: candidate_experience.candidate_profile_id > candidate_profile.id
Ref: candidate_experience.city_id > city.id
Ref: candidate_education.candidate_profile_id > candidate_profile.id
Ref: candidate_project.candidate_profile_id > candidate_profile.id
Ref: candidate_language.candidate_profile_id > candidate_profile.id
Ref: candidate_language.language_lookup_id > language_lookup.id
Ref: candidate_assessment.candidate_profile_id > candidate_profile.id
Ref: candidate_assessment.skill_id > skill.id
Ref: candidate_blocking_entry.candidate_profile_id > candidate_profile.id
Ref: candidate_blocking_entry.blocked_organization_id > organization.id
Ref: candidate_blocking_entry.blocked_user_id > app_user.id
Ref: profile_view_history.viewed_candidate_id > candidate_profile.id
Ref: profile_view_history.viewer_user_id > app_user.id
Ref: recruiter_bookmark.recruiter_user_id > app_user.id
Ref: recruiter_bookmark.candidate_profile_id > candidate_profile.id
Ref: candidate_job_preference.candidate_profile_id - candidate_profile.id
Ref: candidate_job_preference.preferred_job_type_id > job_type_lookup.id
Ref: candidate_job_preference.preferred_city_id > city.id

// --- Jobs & Applications ---
Ref: job_requirement.organization_id > organization.id
Ref: job_requirement.created_by_user_id > app_user.id
Ref: job_requirement.job_type_lookup_id > job_type_lookup.id
Ref: job_requirement.city_id > city.id
Ref: job_requirement_skill.job_requirement_id > job_requirement.id
Ref: job_requirement_skill.skill_id > skill.id
Ref: job_questionnaire.job_requirement_id - job_requirement.id
Ref: questionnaire_question.job_questionnaire_id > job_questionnaire.id
Ref: job_application.job_requirement_id > job_requirement.id
Ref: job_application.candidate_profile_id > candidate_profile.id
Ref: job_application.candidate_resume_id > candidate_resume.id
Ref: job_application.current_status_id > application_status_lookup.id
Ref: application_status_history.job_application_id > job_application.id
Ref: application_status_history.status_lookup_id > application_status_lookup.id
Ref: application_status_history.actor_user_id > app_user.id
Ref: questionnaire_response.job_application_id > job_application.id
Ref: questionnaire_response.questionnaire_question_id > questionnaire_question.id
Ref: consultant_sourcing_request.job_requirement_id > job_requirement.id
Ref: consultant_sourcing_request.consultant_user_id > app_user.id
Ref: consultant_sourcing_request.requesting_organization_id > organization.id

// --- Gig Marketplace ---
Ref: gig_worker_profile.candidate_profile_id - candidate_profile.id
Ref: gig_worker_availability.gig_worker_profile_id > gig_worker_profile.id
Ref: gig_request.organization_id > organization.id
Ref: gig_request.created_by_user_id > app_user.id
Ref: gig_request.required_skill_id > skill.id
Ref: gig_application.gig_request_id > gig_request.id
Ref: gig_application.gig_worker_profile_id > gig_worker_profile.id
Ref: gig_assignment.gig_request_id - gig_request.id
Ref: gig_assignment.gig_worker_profile_id > gig_worker_profile.id
Ref: gig_favorite_blacklist.organization_id > organization.id
Ref: gig_favorite_blacklist.gig_worker_profile_id > gig_worker_profile.id

// --- Notifications ---
Ref: user_preference.app_user_id - app_user.id
Ref: user_preference.preferred_language_id > language_lookup.id
Ref: notification_template.language_lookup_id > language_lookup.id
Ref: notification_delivery.recipient_user_id > app_user.id
Ref: notification_delivery.notification_template_id > notification_template.id

// --- Analytics Star Schema ---
Ref: fact_application_event.dim_date_id > dim_date.id
Ref: fact_application_event.dim_candidate_id > dim_candidate.id
Ref: fact_application_event.dim_job_id > dim_job.id
Ref: fact_application_event.dim_organization_id > dim_organization.id
Ref: fact_credit_consumption.dim_date_id > dim_date.id
Ref: fact_credit_consumption.dim_organization_id > dim_organization.id
Ref: fact_credit_consumption.dim_candidate_id > dim_candidate.id
Ref: fact_gig_completion.dim_date_id > dim_date.id
Ref: fact_gig_completion.dim_organization_id > dim_organization.id
